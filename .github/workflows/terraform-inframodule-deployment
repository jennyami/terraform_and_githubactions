name: Terraform Promotion Pipeline

on:
  push:
    branches:
      # - main

jobs:

  # -----------------
  # DEV
  # -----------------
  dev:
    name: Deploy Dev
    runs-on: ubuntu-latest
    environment: dev

    defaults:
      run:
        working-directory: environments/dev

    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
      - run: terraform init
      - run: terraform apply -auto-approve


  # -----------------
  # QAS
  # -----------------
  qas:
    name: Deploy QAS
    runs-on: ubuntu-latest
    needs: dev
    environment: qas

    defaults:
      run:
        working-directory: environments/qas

    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
      - run: terraform init
      - run: terraform apply -auto-approve


  # -----------------
  # PROD
  # -----------------
  prod:
    name: Deploy Production
    runs-on: ubuntu-latest
    needs: qas
    environment: prod

    defaults:
      run:
        working-directory: environments/prod

    steps:
      - uses: actions/checkout@v4
      - uses: hashicorp/setup-terraform@v3
      - run: terraform init
      - run: terraform apply -auto-approve
